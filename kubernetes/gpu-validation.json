{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "gpu-validation-0",
        "namespace": "glm53-research"
      },
      "spec": {
        "backoffLimit": 0,
        "template": {
          "metadata": {
            "labels": {
              "app": "gpu-validation"
            }
          },
          "spec": {
            "restartPolicy": "Never",
            "runtimeClassName": "nvidia",
            "nodeSelector": {
              "kubernetes.io/hostname": "glm53-h100-0"
            },
            "containers": [
              {
                "name": "validate",
                "image": "docker.io/glm53/sglang:0.5.20-cu130-b27fce60",
                "imagePullPolicy": "Never",
                "command": [
                  "python3",
                  "-c",
                  "import torch, json; assert torch.cuda.device_count()==8; print(json.dumps({\"torch\":torch.__version__,\"cuda\":torch.version.cuda,\"nccl\":torch.cuda.nccl.version(),\"gpus\":[torch.cuda.get_device_name(i) for i in range(8)]})); print([torch.ones(4,device=f\"cuda:{i}\").sum().item() for i in range(8)])"
                ],
                "resources": {
                  "limits": {
                    "nvidia.com/gpu": 8
                  },
                  "requests": {
                    "cpu": 2,
                    "memory": "8Gi",
                    "nvidia.com/gpu": 8
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
