{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "benchmark-client-smoke",
    "namespace": "glm53-research"
  },
  "spec": {
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "app": "research-client",
          "profile": "cookbook-ep8-l1"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "nodeSelector": {
          "kubernetes.io/hostname": "glm53-h100-1"
        },
        "containers": [
          {
            "name": "client",
            "image": "docker.io/glm53/sglang:0.5.20-cu130-b27fce60",
            "imagePullPolicy": "Never",
            "command": [
              "bash",
              "-lc",
              "mkdir -p /benchmarks/smoke; python3 -m sglang.benchmark.serving --backend sglang-oai --base-url http://aggregated-1:30000 --model zai-org/GLM-5.3-Flash --tokenizer /cache/checkpoint --dataset-name random-ids --random-input-len 128 --random-output-len 16 --random-range-ratio 1.0 --num-prompts 2 --max-concurrency 2 --warmup-requests 2 --request-rate inf --temperature 0 --seed 42 --flush-cache --cache-report --output-details --output-file /benchmarks/smoke/client.jsonl"
            ],
            "env": [
              {
                "name": "NVIDIA_VISIBLE_DEVICES",
                "value": "void"
              },
              {
                "name": "HF_HOME",
                "value": "/cache/hf"
              },
              {
                "name": "HF_HUB_OFFLINE",
                "value": "1"
              },
              {
                "name": "TRANSFORMERS_OFFLINE",
                "value": "1"
              },
              {
                "name": "OMP_NUM_THREADS",
                "value": "4"
              }
            ],
            "resources": {
              "requests": {
                "cpu": 4,
                "memory": "16Gi"
              },
              "limits": {
                "memory": "32Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "cache",
                "mountPath": "/cache",
                "readOnly": true
              },
              {
                "name": "scripts",
                "mountPath": "/research",
                "readOnly": true
              },
              {
                "name": "results",
                "mountPath": "/benchmarks"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "cache",
            "persistentVolumeClaim": {
              "claimName": "model-1"
            }
          },
          {
            "name": "scripts",
            "configMap": {
              "name": "research-scripts"
            }
          },
          {
            "name": "results",
            "hostPath": {
              "path": "/root/glm53-research/benchmarks",
              "type": "DirectoryOrCreate"
            }
          }
        ]
      }
    }
  }
}
