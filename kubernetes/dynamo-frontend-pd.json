{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "dynamo-frontend-pd",
        "namespace": "glm53-research"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "dynamo-frontend-pd"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": "25%",
            "maxUnavailable": "25%"
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "dynamo-frontend-pd"
            }
          },
          "spec": {
            "containers": [
              {
                "args": [
                  "--http-host",
                  "0.0.0.0",
                  "--http-port",
                  "8000"
                ],
                "command": [
                  "python3",
                  "-m",
                  "dynamo.frontend"
                ],
                "env": [
                  {
                    "name": "NVIDIA_VISIBLE_DEVICES",
                    "value": "void"
                  },
                  {
                    "name": "DYN_NAMESPACE",
                    "value": "glm53-pd"
                  },
                  {
                    "name": "DYN_DISCOVERY_BACKEND",
                    "value": "etcd"
                  },
                  {
                    "name": "ETCD_ENDPOINTS",
                    "value": "http://etcd:2379"
                  },
                  {
                    "name": "DYN_EVENT_PLANE",
                    "value": "zmq"
                  },
                  {
                    "name": "DYN_REQUEST_PLANE",
                    "value": "tcp"
                  },
                  {
                    "name": "DYN_RESPONSE_PLANE",
                    "value": "tcp"
                  },
                  {
                    "name": "DYN_ROUTER_MODE",
                    "value": "kv"
                  },
                  {
                    "name": "DYN_ROUTER_BLOCK_SIZE",
                    "value": "64"
                  },
                  {
                    "name": "TOKIO_WORKER_THREADS",
                    "value": "8"
                  },
                  {
                    "name": "HF_HOME",
                    "value": "/cache/hf"
                  },
                  {
                    "name": "HF_HUB_OFFLINE",
                    "value": "1"
                  }
                ],
                "image": "docker.io/glm53/sglang-dynamo:0.5.20-1.6.0",
                "imagePullPolicy": "Never",
                "name": "frontend",
                "ports": [
                  {
                    "containerPort": 8000,
                    "name": "http",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/health",
                    "port": "http",
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "memory": "16Gi"
                  },
                  "requests": {
                    "cpu": "4",
                    "memory": "8Gi"
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/research-logs",
                    "name": "logs"
                  },
                  {
                    "mountPath": "/cache",
                    "name": "model-metadata",
                    "readOnly": true
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "nodeSelector": {
              "kubernetes.io/hostname": "glm53-h100-0"
            },
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 30,
            "volumes": [
              {
                "name": "model-metadata",
                "persistentVolumeClaim": {
                  "claimName": "model-0"
                }
              },
              {
                "hostPath": {
                  "path": "/root/glm53-research/logs/dynamo",
                  "type": "DirectoryOrCreate"
                },
                "name": "logs"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "dynamo-frontend-pd",
        "namespace": "glm53-research"
      },
      "spec": {
        "selector": {
          "app": "dynamo-frontend-pd"
        },
        "ports": [
          {
            "name": "http",
            "port": 8000,
            "targetPort": "http"
          }
        ]
      }
    }
  ]
}
