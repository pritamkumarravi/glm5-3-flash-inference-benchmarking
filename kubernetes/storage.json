{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "glm53-research"
      }
    },
    {
      "apiVersion": "storage.k8s.io/v1",
      "kind": "StorageClass",
      "metadata": {
        "name": "glm53-local"
      },
      "provisioner": "kubernetes.io/no-provisioner",
      "volumeBindingMode": "WaitForFirstConsumer",
      "reclaimPolicy": "Retain"
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {
        "name": "glm53-model-0"
      },
      "spec": {
        "capacity": {
          "storage": "600Gi"
        },
        "volumeMode": "Filesystem",
        "accessModes": [
          "ReadWriteOnce"
        ],
        "persistentVolumeReclaimPolicy": "Retain",
        "storageClassName": "glm53-local",
        "local": {
          "path": "/root/glm53-research/model-cache"
        },
        "nodeAffinity": {
          "required": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "kubernetes.io/hostname",
                    "operator": "In",
                    "values": [
                      "glm53-h100-0"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "model-0",
        "namespace": "glm53-research"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "glm53-local",
        "volumeName": "glm53-model-0",
        "resources": {
          "requests": {
            "storage": "600Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {
        "name": "glm53-model-1"
      },
      "spec": {
        "capacity": {
          "storage": "600Gi"
        },
        "volumeMode": "Filesystem",
        "accessModes": [
          "ReadWriteOnce"
        ],
        "persistentVolumeReclaimPolicy": "Retain",
        "storageClassName": "glm53-local",
        "local": {
          "path": "/root/glm53-research/model-cache"
        },
        "nodeAffinity": {
          "required": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "kubernetes.io/hostname",
                    "operator": "In",
                    "values": [
                      "glm53-h100-1"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "model-1",
        "namespace": "glm53-research"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "glm53-local",
        "volumeName": "glm53-model-1",
        "resources": {
          "requests": {
            "storage": "600Gi"
          }
        }
      }
    }
  ]
}
